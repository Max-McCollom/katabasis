# Katabasis repository allowlist  (default-deny)
# ---------------------------------------------------------------------------
# Nothing may be committed unless it is permitted here. See section 2 of the
# build brief. Enforced by .githooks/pre-commit (the local gate) and re-run by
# CI (a backstop). Two rule kinds:
#
#   file:<exact path>                 one individually permitted file
#   dir:<prefix>:<ext> [ext ...]      files under <prefix> with these
#                                     extensions ( * = any extension )
#
# Adding a line here is a deliberate act. If you are unsure whether a file
# belongs in a public repository, it does not go here.

# -- individual root files --------------------------------------------------
file:.allowlist
file:.gitattributes
file:.gitignore
file:README.md
file:package.json
file:package-lock.json
file:vite.config.js
file:index.html
file:public/CNAME
file:public/telemetry/README.md
file:tools/validate-public-telemetry.mjs
file:tools/create-static-routes.mjs
file:public/research/katabasis-overview.pdf

# -- reviewed access infrastructure only; never private research/data --------
file:backend/.gitignore
file:backend/README.md
file:backend/owner-approve.example.sql
file:backend/owner-bootstrap.example.sql
file:backend/owner-revoke.example.sql
file:backend/supabase/function-config.toml
file:backend/supabase/functions/research-download/index.ts
file:backend/supabase/migrations/202611080001_research_access.sql
file:backend/supabase/tests/dashboard-research-access.sql
file:backend/supabase/tests/database/research_access.test.sql
file:src/site/access/tests/access.test.mjs
file:src/site/access/tests/reviewer.test.mjs
file:src/site/access/tests/routing.test.mjs

# -- source and assets ------------------------------------------------------
dir:src/:html css js jsx glsl vert frag json svg
dir:public/:svg png jpg jpeg webp avif ico woff2 mp4 webm vtt xml txt glb gltf bin hdr ktx2 mp3 ogg wav json js wasm
dir:harness/:js mjs json
dir:blender/:py json
dir:procedural/:py json
dir:docs/:md
dir:.github/workflows/:yml
dir:.githooks/:*
